  <rect x="240" y="140" width="490" height="180" fill="#475569" rx="5"/>
  <rect x="260" y="160" width="450" height="20" fill="#64748b" rx="2"/>
  <rect x="260" y="190" width="200" height="15" fill="#64748b" rx="2"/>
