<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <rect width="800" height="600" fill="#1e293b"/>
  <rect x="50" y="50" width="700" height="500" fill="#334155" rx="10"/>
  
  <!-- Header -->
  <rect x="70" y="80" width="660" height="40" fill="#475569" rx="5"/>
