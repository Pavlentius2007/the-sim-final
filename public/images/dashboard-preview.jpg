  <rect x="260" y="240" width="180" height="15" fill="#64748b" rx="2"/>
  <rect x="260" y="265" width="120" height="15" fill="#64748b" rx="2"/>
  
  <!-- Chart Area -->
  <rect x="240" y="340" width="490" height="180" fill="#475569" rx="5"/>
  <rect x="260" y="360" width="450" height="20" fill="#64748b" rx="2"/>
  
  <!-- Chart Lines -->
  <path d="M 280 400 L 320 380 L 360 390 L 400 370 L 440 385 L 480 375 L 520 395 L 560 385 L 600 400 L 640 390 L 680 395" stroke="#3b82f6" stroke-width="3" fill="none"/>
  <path d="M 280 420 L 320 410 L 360 415 L 400 405 L 440 410 L 480 400 L 520 415 L 560 410 L 600 420 L 640 415 L 680 420" stroke="#10b981" stroke-width="3" fill="none"/>
  
  <!-- Stats -->
  <rect x="260" y="450" width="140" height="50" fill="#374151" rx="5"/>
  <rect x="270" y="460" width="120" height="8" fill="#64748b" rx="2"/>
  <rect x="270" y="475" width="80" height="15" fill="#3b82f6" rx="2"/>
  
