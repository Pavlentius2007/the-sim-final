  <rect x="110" y="95" width="100" height="10" fill="#64748b" rx="2"/>
  <rect x="220" y="95" width="80" height="10" fill="#64748b" rx="2"/>
  <rect x="310" y="95" width="60" height="10" fill="#64748b" rx="2"/>
  
